{
  "base_url": "https://www.dmxapi.cn/v1",
  "text_model": "glm-5.3-flash-guan",
  "vision_model": "glm-5.3-flash-guan",
  "timeout_seconds": 180,
  "max_output_tokens": 8192,
  "target_per_document": 5,
